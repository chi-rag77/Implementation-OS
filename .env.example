# For the existing Nexus project, apply only supabase/shared-nexus-migrations,
# expose implementation_os through Data API, and set IMPLEMENTATION_OS_DB_SCHEMA=implementation_os.
# The original supabase/migrations are for a separate, empty Supabase project.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
IMPLEMENTATION_OS_DB_SCHEMA=implementation_os
# Set to workos only after configuring WorkOS as a Supabase Auth OAuth provider.
# WorkOS hosts sign-in; Supabase issues UUID sessions for workspace RLS.
AUTH_PROVIDER=password
# Optional dedicated background worker only. Never set a VITE_ prefix on secrets.
SUPABASE_WORKER_SECRET_KEY=
APP_ORIGIN=http://127.0.0.1:5180
PORT=4100
# Demo can only run in development, bound to loopback, against local PGlite.
IMPLEMENTATION_OS_DEMO=0
# Optional OpenAI-compatible server-side provider. Do not use a VITE_ prefix.
# When configured, selected implementation scope and delivery records are sent
# to this provider only after a user explicitly requests document generation.
AI_PROVIDER=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_PLAN_MODEL=
# NVIDIA hosted testing example: AI_PROVIDER=NVIDIA,
# AI_BASE_URL=https://integrate.api.nvidia.com/v1,
# AI_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b for document drafts,
# AI_PLAN_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b for faster cited plans,
# AI_API_KEY=<server-side key>. AI_PLAN_MODEL defaults to AI_MODEL when blank.
# Or set OPENAI_API_KEY alone to use the OpenAI Responses API with strict JSON
# output (default model: gpt-5.4-mini). Keep this server-side, never VITE_.
OPENAI_API_KEY=
# Or set AI_PROVIDER=Gemini and use Google's Gemini API. The key stays server-side; AI generation sends
# selected implementation records only when a user requests a draft.
# Default model is gemini-3.8-flash when AI_MODEL is blank.
GEMINI_API_KEY=
